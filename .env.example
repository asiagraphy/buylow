# buylow 환경변수 전체 예시
# 실제 값은 Git에서 제외되는 .env.local에만 저장하세요. 이 파일에는 넣지 마세요.
# 기존 .env.local이 없을 때만 복사: cp -n .env.example .env.local
# 실행할 때 명시적으로 읽기: uv run --locked --env-file .env.local python -m orchestrator.us doctor --mode demo
# 미국주식 간편 설정: uv run --locked python -m orchestrator.us setup --mode demo
# setup은 아래 모의/실전 각각의 APP_KEY, APP_SECRET, ACCOUNT_NO만 입력받습니다.
# 선택 항목은 주석 상태로 두면 코드 또는 config.local.yaml의 기본값을 사용합니다.
# 비어 있는 인증 항목은 config.local.yaml의 저장값을 사용할 수 있습니다.

# 1. 한투 미국주식 모의투자: 아래 세 항목 필수
# 한투 Open API에서 모의투자용으로 발급받은 키를 사용하세요. 실전 키와 다릅니다.
BUYLOW_KIS_DEMO_APP_KEY=
BUYLOW_KIS_DEMO_APP_SECRET=
# 주식 모의계좌의 8자리-2자리 번호. 실전 계좌번호를 넣지 마세요.
BUYLOW_KIS_DEMO_ACCOUNT_NO=
# 국내주식 KIS 모의 자동매매의 웹소켓 체결통보에 필요. 미국주식 REST 실행기는 불필요.
BUYLOW_KIS_DEMO_HTS_ID=

# 2. 한투 실전투자: 실전을 사용할 때만 설정
# 미국주식 명령의 --mode real이 이 세 항목을 선택합니다.
BUYLOW_KIS_APP_KEY=
BUYLOW_KIS_APP_SECRET=
BUYLOW_KIS_ACCOUNT_NO=
# 국내주식 KIS 실전 자동매매의 웹소켓 체결통보에 필요. 미국주식 REST 실행기는 불필요.
BUYLOW_KIS_HTS_ID=

# 3. 토스증권: 기존 국내주식 어댑터용, 실전 전용
# 토스증권 WTS의 Open API 설정에서 키를 발급하고 호출 IP를 허용 목록에 등록하세요.
# 계좌는 API로 조회하므로 계좌번호/HTS ID 환경변수는 없습니다.
BUYLOW_TOSS_CLIENT_ID=
BUYLOW_TOSS_CLIENT_SECRET=

# 4. KRX 로그인: 국내 펀더멘털 등 로그인 필요 데이터용
# 미국주식만 사용하면 두 항목 모두 비워 두세요. https://data.krx.co.kr
# 비밀번호에 공백 또는 #가 있으면 값을 작은따옴표로 감싸세요.
KRX_ID=
KRX_PW=

# 5. 국내주식 대시보드의 증권사 선택: kis_demo / kis / toss
# 이 줄은 대시보드에서 저장한 선택보다 우선합니다.
# 대시보드에서 증권사를 바꾸려면 이 줄을 주석 처리하세요.
# 미국주식 명령에는 적용되지 않으며, 그쪽은 --mode demo 또는 --mode real로 선택합니다.
BUYLOW_BROKER=kis_demo

# 6. 국내주식 대시보드 선택 설정
# 인증 없는 거래 제어 화면이므로 호스트를 외부 네트워크에 공개하지 마세요.
# BUYLOW_DASHBOARD_HOST=127.0.0.1
# BUYLOW_DASHBOARD_PORT=8420
# Docker Compose 호스트 포트만 변경. 컨테이너 내부 대시보드 포트와 다릅니다.
# BUYLOW_PORT=8420

# 7. 국내주식 LEAN 자동매매 선택 설정
# 주석 해제 시 대시보드의 저장값보다 우선합니다. false는 대시보드의 ON도 막습니다.
# true는 조건이 갖춰지면 서버 시작 시 매매를 재개할 수 있습니다.
# 미국주식 실행기에는 적용되지 않습니다. 미국주식은 run 명령으로 시작합니다.
# BUYLOW_LIVE_ENABLED=false
# 주문 1건의 원화 금액 상한. 0은 한도 없음. 미국주식의 USD 예산과 무관합니다.
# BUYLOW_LIVE_MAX_ORDER_AMOUNT=0

# 8. 국내주식 로컬 저장 경로 선택 설정
# 프로젝트 폴더에서 실행하는 경우의 기본 경로입니다. 별도 경로는 직접 지정하세요.
# BUYLOW_CONFIG_LOCAL=config.local.yaml
# BUYLOW_DB_PATH=buylow.db
# BUYLOW_KIS_TOKEN_CACHE=.kis_token.json
# BUYLOW_TOSS_TOKEN_CACHE=.toss_token.json
# LEAN_DATA_DIR=data
# 미국주식 상태/토큰은 state/us-trading/demo 및 state/us-trading/real에 따로 저장됩니다.
# 미국주식 경로를 바꾸는 환경변수는 현재 제공하지 않습니다.

# 9. 국내주식 .NET/LEAN 도구 경로 선택 설정
# 보통 자동 탐색하므로 설정하지 않습니다. 필요한 경우 각 도구의 설치 경로를 넣으세요.
# 미국주식 터미널 실행기는 .NET과 NuGet을 사용하지 않습니다.
# DOTNET_ROOT=
# NUGET_PACKAGES=

# 10. 국내주식 분봉 시드 다운로드/배포 스크립트 선택 설정
# BUYLOW_REPO=JeongSeongMok/buylow
# BUYLOW_SEED_TAG=minute-seed
# 셸 스크립트와 Docker Compose는 uv와 별도로 환경변수를 읽습니다.
# Docker에 .env.local의 비밀값이 자동 전달되는 것은 아닙니다. README의 해당 절차를 따르세요.

# 미국주식 전략, 예산, 종목, 실험 이름, 수수료는 환경변수가 아닌 명령 옵션입니다.
# --strategy momentum / opening-range, --budget USD, --stocks AAPL,NYSE:IBM
# --trial week1, --commission-bps 25 (편도 0.25% 가정, 본인 약정 수수료와 다를 수 있음)
# --universe-mode auto (자동 종목 탐색) / manual (수동 지정, CLI 기본값)
# 자동 모드에서는 --stocks를 사용하지 않습니다. 웹에서도 탐색 방식을 선택할 수 있습니다.
